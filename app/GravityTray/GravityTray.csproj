<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyTitle>Gravity 音响托盘面板</AssemblyTitle>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="NAudio" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\index.html" Link="web\index.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\icon.ico" Link="icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\icon-src.png" Link="web\icon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\fix-firewall.ps1" Link="fix-firewall.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
