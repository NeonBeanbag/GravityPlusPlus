<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GravityPanel.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel x:Name="Body" Spacing="12">

        <Border x:Name="PlayCard" Style="{StaticResource PanelCard}" Visibility="Collapsed">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="64" Height="64" CornerRadius="6"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Image x:Name="Cover" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                    <TextBlock x:Name="NowLine" Text="—" Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" MaxLines="2" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button x:Name="BtnPrev" Click="OnPrev" ToolTipService.ToolTip="上一首">
                            <FontIcon Glyph="&#xE892;" FontSize="14" />
                        </Button>
                        <Button x:Name="BtnPlay" Style="{StaticResource AccentButtonStyle}" Click="OnPlayPause"
                                ToolTipService.ToolTip="播放 / 暂停">
                            <FontIcon x:Name="PlayGlyph" Glyph="&#xE768;" FontSize="14" />
                        </Button>
                        <Button x:Name="BtnNext" Click="OnNext" ToolTipService.ToolTip="下一首">
                            <FontIcon Glyph="&#xE893;" FontSize="14" />
                        </Button>
                        <Button x:Name="BtnRefresh" Click="OnRefresh" ToolTipService.ToolTip="刷新信息">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

            <Border x:Name="VolCard" Style="{StaticResource PanelCard}" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="音量" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ComboBox Grid.Column="1" x:Name="EqBox" MinWidth="0" HorizontalAlignment="Right"
                                  PlaceholderText="选择音效" SelectionChanged="OnEqChanged" />
                    </Grid>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="Vol" Grid.Column="0" Minimum="0" Maximum="100" Value="10" />
                        <TextBlock x:Name="VolNum" Grid.Column="1" Text="10" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelCard}">
                <StackPanel Spacing="10">
                    <ToggleButton x:Name="ConnToggle" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="设备连接" VerticalAlignment="Center"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                                <Ellipse x:Name="Dot" Width="9" Height="9" VerticalAlignment="Center"
                                         Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock x:Name="ConnState" Text="未连接" VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="2" x:Name="BtnEnv" Content="自检">
                                <Button.Flyout>
                                    <Flyout x:Name="EnvFly" Placement="Bottom">
                                        <StackPanel Width="300" Spacing="8">
                                            <Grid ColumnSpacing="10" RowSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Text="电脑当前 Wi-Fi" VerticalAlignment="Center" />
                                                <TextBlock x:Name="EnvSsid" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                                           Text="—" VerticalAlignment="Center" HorizontalAlignment="Right" />

                                                <TextBlock Grid.Row="1" Text="本机 WLAN IP" VerticalAlignment="Center" />
                                                <TextBlock x:Name="EnvIp" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                           Text="—" VerticalAlignment="Center" HorizontalAlignment="Right" />

                                                <TextBlock Grid.Row="2" Text="数据包合并" VerticalAlignment="Center" />
                                                <TextBlock x:Name="EnvCoal" Grid.Row="2" Grid.Column="1" Text="—" VerticalAlignment="Center" />
                                                <Button x:Name="BtnFixCoal" Grid.Row="2" Grid.Column="2" Content="关掉它"
                                                        Click="OnFixCoalescing" Visibility="Collapsed" />

                                                <TextBlock Grid.Row="3" Text="推流入站规则" VerticalAlignment="Center" />
                                                <TextBlock x:Name="EnvFw" Grid.Row="3" Grid.Column="1" Text="—" VerticalAlignment="Center" />
                                                <Button x:Name="BtnFixFw" Grid.Row="3" Grid.Column="2" Content="放行"
                                                        Click="OnFixFirewall" Visibility="Collapsed" />
                                            </Grid>
                                            <Button Content="重新自检" Click="OnEnvRefresh" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <FontIcon Grid.Column="3" Glyph="&#xE70D;" FontSize="12" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </ToggleButton>

                    <StackPanel x:Name="ConnBody" Spacing="10" Visibility="Collapsed">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="IpBox" Grid.Column="0" PlaceholderText="音响 IP，如 192.168.1.55"
                                     KeyDown="OnIpKeyDown" />
                            <Button x:Name="BtnConnect" Grid.Column="1" Style="{StaticResource AccentButtonStyle}"
                                    Content="连接" Click="OnConnect" />
                            <Button x:Name="BtnScan" Grid.Column="2" Content="扫描局域网" Click="OnScan" />
                        </Grid>
                        <ItemsControl x:Name="ScanList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <ToggleButton x:Name="ProvToggle" Content="给音响配网" HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Left" />
                        <StackPanel x:Name="ProvBody" Spacing="10" Visibility="Collapsed">
                            <ComboBox x:Name="SsidBox" Header="目标 Wi-Fi（2.4GHz）" HorizontalAlignment="Stretch"
                                      IsEditable="True" PlaceholderText="如 MyWiFi-A" />
                            <PasswordBox x:Name="PassBox" Header="密码" PlaceholderText="Wi-Fi 密码" />
                            <TextBox x:Name="SpeakerIpBox" Header="音响 IP（可留空）" PlaceholderText="配网结束后回读它解到的账号" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="BtnStart" Style="{StaticResource AccentButtonStyle}" Content="开始配网" Click="OnStart" />
                                <Button x:Name="BtnStop" Content="停止" Click="OnStop" IsEnabled="False" />
                            </StackPanel>
                            <ProgressBar x:Name="PvBar" IsIndeterminate="True" Visibility="Collapsed" />
                            <TextBlock x:Name="PvState" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <InfoBar x:Name="PvResult" IsOpen="False" Severity="Informational" />
                            <TextBlock Text="先在音响上同时按背面 + − 两秒，进配网模式。"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

    </StackPanel>
</UserControl>
