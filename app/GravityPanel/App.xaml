<?xml version="1.0" encoding="utf-8"?>
<!--
  这个文件唯一的用途：把 XamlControlsResources 合并进 Application.Resources，
  让官方模板化控件(Pivot / Button / Slider / InfoBar / ToggleSwitch …)拿得到默认 ControlTemplate。

  ★ 三条前置条件缺一不可(与 AgentLauncher 同一套实测结论)：
     1) 本文件存在且合并 XamlControlsResources
     2) csproj 打开 AppxGeneratePriEnabled(工具链路径由同目录 Directory.Build.props 喂)
     3) WindowsAppSDK >= 1.8 —— 1.5 上带着本文件启动即 0xC000027B
-->
<Application
    x:Class="GravityPanel.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 面板里的"卡片"：全部取主题键，不写死颜色/圆角 -->
            <Style x:Key="PanelCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="16" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
